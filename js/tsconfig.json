{
    "compilerOptions": {
        "skipLibCheck": true,
        "forceConsistentCasingInFileNames": true,
        "declaration": true,
        "declarationDir": "./dist/types",
        "emitDeclarationOnly": false,
        "stripInternal": true,
        "noImplicitAny": true,
        "target": "es2017",
        "module": "es2015",
        "lib": [
            "es2019",
            "DOM",
            "DOM.Iterable"
        ],
        "moduleResolution": "node",
        "esModuleInterop": true,
        "strict": true,
        "alwaysStrict": true,
        "noUnusedParameters": true,
        "noUnusedLocals": true
    },
    "include": [
        "ts/**/*"
    ]
}